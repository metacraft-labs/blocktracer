# The CodeTracer Embed SDK the Client SDK is built and checked against.
#
# ONE place, read by both `ci/test/embed-handoff-test.sh` and
# `.github/workflows/ci.yml`, so the version the handoff compiles against and
# the version the boundary guard scans can never be two different things.
#
# WHY A COMMIT AND NOT A BRANCH NAME
# ----------------------------------
# The Embed SDK is now on `codetracer` `dev`: the facade
# (`src/frontend/viewmodel/codetracer_embed.nim`), its `DebuggerSession`,
# `TraceSource` and its own boundary guard landed as `b2fc33c9`, and M2b's
# degraded-state model and its two verification suites followed. The pin below
# is `dev` at that point, recorded as a COMMIT rather than as `dev`, so a push
# to that branch cannot silently change what CI checked here — a green build in
# this repository has to name the bytes it was green against.
#
# Moving the pin forward is a deliberate edit of this file, and the two things
# it must survive are `ci/test/embed-handoff-test.sh --require` (the handoff
# still compiles against that Embed SDK) and
# `ci/test/client-sdk-boundary.sh --require-embed` (that Embed SDK still
# carries no chain concept). Nothing else in this repository needs to change.
CODETRACER_REPO=metacraft-labs/codetracer
CODETRACER_REF=813510ad5678be5c5a18a855b6d4ead5bedc1c77
CODETRACER_BRANCH=dev

# The IsoNim / nim-everywhere sources the Embed SDK's own graph needs
# (`isonim/core/signals`, `isonim/viewmodel`, `isonim/testing/test_utils`).
# Kept in lock-step with flake.nix's pinned inputs.
ISONIM_REPO=metacraft-labs/isonim
ISONIM_REF=03f8349784b2642ba5b49101f1a04b454b3476f3
NIM_EVERYWHERE_REPO=metacraft-labs/nim-everywhere
NIM_EVERYWHERE_REF=b2ce1c6b31743c4351aff4ad835f385f79b70edd
