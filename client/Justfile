# BlockTracer IsoNim client — workspace commands.
# Mirrors the reprobuild-web-site / codetracer-web-site static-site Justfile.

# Export the combined static site to dist/: the demo data plane (/d /idx /t
# /registry + entry pages) with the rendered explorer views (home, chain, block
# list, block detail, tx detail) written over it at clean URLs, plus fonts,
# sitemap.xml and robots.txt.
export:
    nim c -r --mm:orc -d:isServer -d:release src/static_export.nim

# ── Hydration (the debug route's live session) ─────────────────────────────

# Build the hydration bundle: `nim js` over client/hydrate/hydrate.nim, WITH
# the CodeTracer Embed SDK on the Nim path.
#
# This is the one compilation in the repository that links a debugger. Keeping
# it a separate target — and a separate Nim invocation from `export` — is what
# preserves the property `AGENTS.md` §1a states: everything else compiles with
# no debugger on the Nim path at all. `export` reads the RESULT of this as a
# file; it does not depend on the Embed SDK to run.
#
# Sources resolve exactly as ci/test/debug-panes-test.sh resolves them —
# $CODETRACER_SRC, else a ../codetracer sibling — because a second convention
# for locating the same tree is a second thing to keep in step. The pinned
# commit is in ci/embed-sdk-pin.env.
hydrate:
    ./hydrate/build.sh

# export, with hydration. The two-step order is the point: the bundle is built
# FIRST, and only then is the exporter compiled with a -d:hydrationBundle that
# names it — so a page can never carry a <script> for a file that was not
# produced. `installHydrationBundle` re-checks that and fails the build.
export-hydrated: hydrate
    nim c -r --mm:orc -d:isServer -d:release \
      -d:hydrationBundle=/assets/hydrate.js src/static_export.nim

# Copy the published replay engine into dist/replay-engine/ so a LOCAL preview
# has a live session.
#
# CodeTracer-Embed-SDK.md §5.1: `new Worker(scriptURL)` requires a same-origin
# script, which is why `ReplayEngineBase` defaults to `/replay-engine/` and why
# the engine has to be COPIED to the origin that serves the page rather than
# linked from the one that publishes it. This is §5.1's "copy to own origin"
# mode, which is the recommended one, done by hand for a preview.
#
# Not part of `export`, and not committed: it is 18 MB of build output from
# another repository, and a deploy decides for itself whether to carry it (or
# to point -d:replayEngineBase at an origin that already does).
replay-engine BASE="https://web-codetracer.pages.dev":
    ./hydrate/fetch-engine.sh dist/replay-engine {{BASE}}

# Everything a live local session needs: the site with hydration, and an engine
# for it to load. Then serve it.
preview-live: export-hydrated replay-engine
    cd dist && python3 -m http.server 8080

# Run the client suites: the static-export round trip, BlockTracer's own
# ViewModel layer (M12), and the debug route (M8a/M8b).
test: test-export test-viewmodels test-debug-route test-entry-state test-hydration-tag test-explorer-breadth test-chain-provenance test-capability-tour test-instruction-listing test-scrub-queue

# The static-export round-trip test: compile + run the real exporter into a
# temp dir, then assert the three view types render for the demo entities and
# reference real /d demo data, and that the design-system token layer resolved.
test-export:
    nim c -r --mm:orc --hints:off tests/test_static_export.nim

# Tier-1 tests for BlockTracer's OWN ViewModels (Front-End-Architecture.md §3):
# every chain-shaped degraded state from Page-Descriptions.md §14, established
# from a mock chain and walked exhaustively. Needs no debugger on the Nim path
# at all — the half of the seam that does is `just viewmodel-seam` in the repo
# root's Justfile.
test-viewmodels:
    nim c -r --mm:orc --hints:off tests/test_chain_viewmodels.nim

# M8a/M8b: the `/{chain}/tx/{hash}/debug` route — the arrangement walked off
# CodeTracer's LayoutNode, the five pane renderers, the static source renderer,
# §7.0's availability-decides-the-landing rule, and the crawl-surface baseline.
# Hermetic: no debugger on the Nim path. The half that DOES need one is
# `just debug-panes` in the repository root's Justfile.
test-debug-route:
    nim c -r --mm:orc --hints:off tests/test_debug_route.nim

# The scrubber's coalescing rule, as orderings rather than as a race.
#
# The one failure this rule has is a drag that ends where the visitor merely
# dragged THROUGH, it shipped once, and a browser-level mutation arm aimed at it
# SURVIVED — the window is a single microtask drain wide. `scrub_queue.nim` is
# pure data so the ordering can be stated directly. See its header.
test-scrub-queue:
    nim c -r --mm:orc --hints:off tests/test_scrub_queue.nim

# How a session BECOMES positioned, as opposed to how a positioned one renders.
#
# `test_debug_route.nim` covers the second exhaustively and the first not at
# all: its cases build a fixture from `demo_session.FixtureFile`/`FixtureLine`
# and then assert those same two constants back, so fixture and assertion share
# a source. It could not have caught a session that opened on the wrong file,
# and it did not. Nothing in this suite may name a path or a line as the
# expected answer — every expectation is a RELATION over the session's own
# reported position.
test-entry-state:
    nim c -r --mm:orc -d:isServer --hints:off tests/test_entry_state.nim

# The two-producer honesty contract: a rung-3 recording never renders as
# source, a transaction past the retention horizon says so in the producer's
# own words, a real divergence is published as one, and real and synthetic
# data are tellable apart ON THE PAGE. Built over the committed chain capture
# by the REAL producers, and it refuses rather than skips when the capture is
# missing — every arm would otherwise pass vacuously on a one-chain tree.
test-chain-provenance:
    nim c -r --mm:orc --hints:off tests/test_chain_provenance.nim

# tests/test_capability_tour.nim — that every entry of the demo chain's tour is a
# real recording of ITS OWN program: distinct containers, per-transaction source
# bundles, published counts that match the bytes beside them, and no page that
# shows two programs at once. Builds the tree with the real `generate`.
test-capability-tour:
    nim c -r --mm:orc --hints:off tests/test_capability_tour.nim

# tests/test_instruction_listing.nim — the Code pane's honest floor. A real
# chain recording is rung 3, and the pane used to answer that with prose and
# nothing else: it described a stream of program counters and rendered none of
# them. This grades the listing over the COMMITTED captures through the real
# producers — that the mnemonics are earned per recording by reproducing that
# recording's own program counters, that exactly one row is marked and it is the
# step the toolbar counts, that no branch glyph or lexer reaches a listing, that
# the corrected prose sits beside the rows, that a source-level session is
# untouched, and that the island a hydrated session re-renders from carries the
# whole listing rather than the served window.
test-instruction-listing:
    nim c -r --mm:orc --hints:off tests/test_instruction_listing.nim

# The hydration bundle's <script> is EMITTED when one is declared. Compiled
# WITH -d:hydrationBundle on purpose: every other suite compiles without it and
# asserts the empty case, so nothing else in the tree ever checks that a
# declared bundle is actually referenced. (Corrected 2026-08-30: this recipe
# used to say a top-level `if` inside `ui:` had dropped the tag in production.
# It had not — see the correction in src/components/layout.nim.)
test-hydration-tag:
    nim c -r --mm:orc --hints:off -d:hydrationBundle=/assets/hydrate.js tests/test_hydration_tag.nim

# M9: the explorer breadth slice — the milestone's three named verifications
# (renders from published files only, pointer objects are not cached across
# navigations, address history pages with constant per-page cost) plus the two
# product rules asserted over EVERY rendered page. Built with -d:release: one
# of them walks a synthetic address with a hundred thousand transactions from
# its first page to its last.
test-explorer-breadth:
    nim c -r --mm:orc -d:release --hints:off tests/test_explorer_breadth.nim

# Build and preview the static site locally on :8080.
preview: export
    cd dist && python3 -m http.server 8080

# Live-reload dev server: runs the real exporter, serves dist/, and reloads every
# open tab on any edit under src/ or ../src (the shared contract + demo generator).
# `just dev [PORT] [HOST]`, default 127.0.0.1:8080.
dev *ARGS:
    nim c -r --mm:orc --hints:off src/dev.nim {{ARGS}}

# Remove build artifacts.
clean:
    rm -rf dist nimcache
    find . -name nimcache -type d -exec rm -rf {} +
    rm -f src/static_export tests/test_static_export tests/test_chain_viewmodels tests/test_debug_route tests/test_explorer_breadth tests/test_entry_state tests/test_chain_provenance tests/test_capability_tour
