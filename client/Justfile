# BlockTracer IsoNim client — workspace commands.
# Mirrors the reprobuild-web-site / codetracer-web-site static-site Justfile.

# Export the combined static site to dist/: the demo data plane (/d /idx /t
# /registry + entry pages) with the rendered explorer views (home, chain, block
# list, block detail, tx detail) written over it at clean URLs, plus fonts,
# sitemap.xml and robots.txt.
export:
    nim c -r --mm:orc -d:isServer -d:release src/static_export.nim

# Run the client suites: the static-export round trip, BlockTracer's own
# ViewModel layer (M12), and the debug route (M8a/M8b).
test: test-export test-viewmodels test-debug-route test-explorer-breadth

# The static-export round-trip test: compile + run the real exporter into a
# temp dir, then assert the three view types render for the demo entities and
# reference real /d demo data, and that the design-system token layer resolved.
test-export:
    nim c -r --mm:orc --hints:off tests/test_static_export.nim

# Tier-1 tests for BlockTracer's OWN ViewModels (Front-End-Architecture.md §3):
# every chain-shaped degraded state from Page-Descriptions.md §14, established
# from a mock chain and walked exhaustively. Needs no debugger on the Nim path
# at all — the half of the seam that does is `just viewmodel-seam` in the repo
# root's Justfile.
test-viewmodels:
    nim c -r --mm:orc --hints:off tests/test_chain_viewmodels.nim

# M8a/M8b: the `/{chain}/tx/{hash}/debug` route — the arrangement walked off
# CodeTracer's LayoutNode, the five pane renderers, the static source renderer,
# §7.0's availability-decides-the-landing rule, and the crawl-surface baseline.
# Hermetic: no debugger on the Nim path. The half that DOES need one is
# `just debug-panes` in the repository root's Justfile.
test-debug-route:
    nim c -r --mm:orc --hints:off tests/test_debug_route.nim

# M9: the explorer breadth slice — the milestone's three named verifications
# (renders from published files only, pointer objects are not cached across
# navigations, address history pages with constant per-page cost) plus the two
# product rules asserted over EVERY rendered page. Built with -d:release: one
# of them walks a synthetic address with a hundred thousand transactions from
# its first page to its last.
test-explorer-breadth:
    nim c -r --mm:orc -d:release --hints:off tests/test_explorer_breadth.nim

# Build and preview the static site locally on :8080.
preview: export
    cd dist && python3 -m http.server 8080

# Live-reload dev server: runs the real exporter, serves dist/, and reloads every
# open tab on any edit under src/ or ../src (the shared contract + demo generator).
# `just dev [PORT] [HOST]`, default 127.0.0.1:8080.
dev *ARGS:
    nim c -r --mm:orc --hints:off src/dev.nim {{ARGS}}

# Remove build artifacts.
clean:
    rm -rf dist nimcache
    find . -name nimcache -type d -exec rm -rf {} +
    rm -f src/static_export tests/test_static_export tests/test_chain_viewmodels tests/test_debug_route tests/test_explorer_breadth
