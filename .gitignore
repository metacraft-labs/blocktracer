# Nim build artifacts
nimcache/
/blocktracer_demo_gen
/blocktracer_validate
/blocktracer_publish
/blocktracer-demo-gen
/blocktracer-validate
/blocktracer-publish
# `nim c -r src/foo.nim` drops the compiled binary next to its source, under src/
/src/blocktracer_demo_gen
/src/blocktracer_validate
/src/blocktracer_publish
*.exe

# Compiled test binaries (`nim c -r tests/foo.nim` drops a `tests/foo` next to it)
/tests/tcontract
/tests/tpublish
/tests/tmutcheck
/tests/tclientsdk
/tests/tembedhandoff
/tests/tviewmodelseam
/tests/tdebugpanes

# Generated output trees. `demo-site-2` is the determinism check's second
# tree (`just demo-gen out=demo-site-2` in CI), which the first .gitignore
# missed.
/demo-site/
/demo-site-2/
/out/
/published/

# Nix build result symlinks (`nix build` at the repo root)
/result
/result-*

# Cloudflare Pages deploy: wrangler's local cache/logs and the staged publish
# dir (`cp -rL result site`) the deploy workflow uploads.
/.wrangler/
/site/
/wrangler-deploy.log

# Visual-design capture harness (VD.0). The images are build output: they are
# regenerated from a fixed seed in a pinned capture environment
# (tools/capture/capture-env.nix), so committing them would put megabytes of
# derived PNGs in history for no gain. The view list and the manifest schema
# are the artefacts worth versioning, and they live in tools/capture/.
/screenshots/
/tools/capture/node_modules/

# direnv's materialised profile (the .envrc itself IS versioned)
/.direnv/

# Editor / OS
.DS_Store

# The hydration bundle and its nimcache are build output of `just hydrate`.
/client/hydrate/hydrate.js
/client/hydrate/nimcache/

# The exported site, which now also holds the replay engine copied to this
# origin by `just replay-engine` — 18 MB of another repository's published
# build output. See client/hydrate/fetch-engine.sh for why it is fetched at
# build time and not vendored.
/client/dist/

# The capture harness's SECOND tree: the same exporter with
# -d:hydrationBundle, built by `capture.mjs`'s runHydratedExporter so that
# §6.0a's landing notice and the three engine-failure sentences — which are
# rendered by the hydration bundle and by nothing else — can be photographed
# without moving `client/dist`, which is what the other 63 views and
# `tools/design/check-tokens.mjs`'s D1 read.
/client/dist-hydrated/
/client/.hydrated-build/
/client/nimcache-hydrated/
